# SwiftPM and app build output
.build/
.swiftpm/
build/
dist/
*.app
*.xcarchive
DerivedData/

# Recognition and embedding models (downloaded by a script, hundreds of MB)
/models/
*.bin
*.gguf

# The owner's personal data: résumé, stories, question bank, sessions
/profile/
!profile.example/
/sessions/

# Secrets (keys are stored only in the macOS Keychain)
.env
.env.*
*.p12
*.cer
*.key

# Eval results and logs
evals/results/
/logs/
*.log

# System files
.DS_Store

# Python bytecode from the helper scripts
__pycache__/
*.pyc

# Synthetic mixes for the filter eval (COPILOT-05) — generated by scripts/make-filter-fixtures.py
/evals/audio/filter/
/evals/audio/voice/
/evals/audio/noisy/
